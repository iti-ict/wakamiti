<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
    <module name="NewlineAtEndOfFile" />
    <module name="FileTabCharacter">
        <property name="eachLine" value="true" />
    </module>
    <module name="RegexpSingleline">
        <property name="format" value="\s+$" />
        <property name="message" value="Line has trailing whitespace." />
    </module>
    <module name="Header">
        <property name="headerFile" value="${checkstyle.config.folder}/java.header"/>
        <property name="fileExtensions" value="java" />
    </module>
    <module name="RegexpMultiline">
        <property name="id" value="noBlankLineAfterCopyrightHeader" />
        <property name="format" value="(?ms)\*/\r?\n(?!package\b).*?^[ \t]*package\b" />
        <property name="maximum" value="0" />
        <property name="message"
                  value="The package declaration must immediately follow the copyright header." />
    </module>
    <module name="LineLength">
        <property name="max" value="${checkstyle.lineLength}" />
        <property name="ignorePattern"
                  value="^package .*|^import .*|https?://|^\s*\*" />
    </module>
    <module name="TreeWalker">
        <module name="EmptyStatement" />
        <module name="es.iti.wakamiti.checkstyle.checks.PackageImportSpacingCheck" />
        <module name="es.iti.wakamiti.checkstyle.checks.BlockBoundaryBlankLineCheck" />
        <module name="es.iti.wakamiti.checkstyle.checks.TypeClosingBlankLineCheck" />
        <module name="es.iti.wakamiti.checkstyle.checks.CallableSeparationCheck" />
        <module name="es.iti.wakamiti.checkstyle.checks.DeclarationParametersPerLineCheck" />
        <module name="GenericWhitespace" />
        <module name="NoWhitespaceAfter">
            <property name="tokens"
                      value="BNOT, DEC, DOT, INC, LNOT, UNARY_MINUS, UNARY_PLUS" />
        </module>
        <module name="NoWhitespaceBefore" />
        <module name="ParenPad" />
        <module name="TypecastParenPad" />
        <module name="WhitespaceAfter" />
        <module name="WhitespaceAround" />
    </module>
</module>
