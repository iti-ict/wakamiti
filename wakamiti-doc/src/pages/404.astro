---
import SiteLayout from "../layouts/SiteLayout.astro";
import { messages, withBase } from "../lib/site.js";

const esHome = withBase("/");
const enHome = withBase("/en/");
const basePath = (import.meta.env.BASE_URL || "/").replace(/\/$/, "");
const text = messages.es;
---

<SiteLayout locale="es" title="404 | Wakamiti" description={text.notFoundDescription} sidebar={false} currentSlug="/">
  <div
    class="not-found"
    data-not-found
    data-base-path={basePath}
    data-es-home={esHome}
    data-en-home={enHome}
    data-es-message={messages.es.notFoundMessage}
    data-en-message={messages.en.notFoundMessage}
    data-es-link-text={messages.es.notFoundHome}
    data-en-link-text={messages.en.notFoundHome}
    data-es-description={messages.es.notFoundDescription}
    data-en-description={messages.en.notFoundDescription}
  >
    <h1>404</h1>
    <p data-not-found-message>{text.notFoundMessage}</p>
    <p><a href={esHome} data-not-found-link>{text.notFoundHome}</a></p>
  </div>
</SiteLayout>

<script is:inline>
  const container = document.querySelector("[data-not-found]");

  if (container) {
    const basePath = container.getAttribute("data-base-path") || "";
    const pathname = window.location.pathname;
    const enPrefix = `${basePath}/en`;
    const locale = pathname === enPrefix || pathname.startsWith(`${enPrefix}/`) ? "en" : "es";
    const otherLocale = locale === "en" ? "es" : "en";
    const message = container.querySelector("[data-not-found-message]");
    const link = container.querySelector("[data-not-found-link]");
    const description = document.querySelector('meta[name="description"]');
    const languageSwitch = document.getElementById("languageSwitch");

    document.documentElement.lang = locale;

    if (message) {
      message.textContent = container.getAttribute(`data-${locale}-message`) || "";
    }

    if (link) {
      link.textContent = container.getAttribute(`data-${locale}-link-text`) || "";
      link.setAttribute("href", container.getAttribute(`data-${locale}-home`) || "/");
    }

    if (description) {
      description.setAttribute("content", container.getAttribute(`data-${locale}-description`) || "");
    }

    if (languageSwitch) {
      languageSwitch.setAttribute("data-language-switch", container.getAttribute(`data-${otherLocale}-home`) || "/");
      languageSwitch.setAttribute("data-language-next-text", locale.toUpperCase());

      const label = languageSwitch.querySelector(".language-text");
      if (label) {
        label.textContent = otherLocale.toUpperCase();
      }
    }
  }
</script>

<style lang="scss">
.not-found {
  padding: 4rem 0;
  text-align: center;
}

.not-found p {
  opacity: .8;
}
</style>
